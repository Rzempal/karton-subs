<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Scaling Group (Center 22,20 | Scale 0.32) -->
  <group
      android:translateX="22"
      android:translateY="20"
      android:scaleX="0.32"
      android:scaleY="0.32">

      <!-- Shadow -->
      <path android:pathData="M12,68 L98,108 L98,186 L188,146 L188,68 L100,24 Z"
            android:fillColor="#000000"
            android:fillAlpha="0.3"/>

      <!-- Box: Top Face (Cardboard Light) -->
      <path android:pathData="M100,24 L186,64 L100,104 L14,64 Z"
            android:fillColor="#D4A574"/>

      <!-- Tape: Top (Bright Blue) -->
      <path android:pathData="M35,73.8 L65,87.7 L151,47.7 L121,33.8 Z"
            android:fillColor="#2563EB"/>

      <!-- Box: Left Face (Cardboard Dark) -->
      <path android:pathData="M12,68 L98,108 L98,186 L12,146 Z"
            android:fillColor="#9B7653"/>

      <!-- Tape: Left (Dark Blue Border) -->
      <path android:pathData="M35,78.7 L65,92.7 L65,140 L35,125 Z"
            android:fillColor="#1E3A5F"/>

      <!-- Box: Right Face (Cardboard Medium) -->
      <path android:pathData="M188,68 L188,146 L102,186 L102,108 Z"
            android:fillColor="#B8896A"/>

      <!-- Gem Symbol (Lucide gem) on right face -->
      <!-- Right face center: (145,127), top edge angle: -25° -->
      <group
          android:translateX="145"
          android:translateY="127"
          android:rotation="-25"
          android:pivotX="0"
          android:pivotY="0">
          <group
              android:scaleX="2.2"
              android:scaleY="2.2"
              android:translateX="-12"
              android:translateY="-12"
              android:pivotX="12"
              android:pivotY="12">
              <!-- Gem outline -->
              <path android:pathData="M17,3 a2,2 0 0,1 1.6,0.8 l3,4 a2,2 0 0,1 0.013,2.382 l-7.99,10.986 a2,2 0 0,1 -3.247,0 l-7.99,-10.986 A2,2 0 0,1 2.4,7.8 l2.998,-3.997 A2,2 0 0,1 7,3 z"
                    android:strokeColor="#2563EB"
                    android:strokeWidth="2"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:fillColor="#00000000"/>
              <!-- Gem facets -->
              <path android:pathData="M10.5,3 L8,9 L12,22 L16,9 L13.5,3"
                    android:strokeColor="#2563EB"
                    android:strokeWidth="2"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:fillColor="#00000000"/>
              <!-- Gem horizontal line -->
              <path android:pathData="M2,9 L22,9"
                    android:strokeColor="#2563EB"
                    android:strokeWidth="2"
                    android:strokeLineCap="round"
                    android:fillColor="#00000000"/>
          </group>
      </group>

      <!-- Tape: Connector -->
      <path android:pathData="M35,73.8 L65,87.7 L65,92.7 L35,78.7 Z"
            android:fillColor="#1E3A5F"/>

      <!-- Glass Overlay (Gloss) -->
      <path android:pathData="M100,24 L186,64 L100,104 L14,64 Z">
        <aapt:attr name="android:fillColor">
          <gradient
              android:startX="100"
              android:startY="24"
              android:endX="100"
              android:endY="104"
              android:type="linear">
            <item android:offset="0.0" android:color="#80FFFFFF"/>
            <item android:offset="1.0" android:color="#00FFFFFF"/>
          </gradient>
        </aapt:attr>
      </path>

      <!-- Rim Light Stroke -->
      <path android:pathData="M14,64 L100,24 L186,64"
            android:strokeColor="#66FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"/>

  </group>
</vector>

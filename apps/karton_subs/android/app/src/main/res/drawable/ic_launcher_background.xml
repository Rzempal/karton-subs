<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Base Background: Near-black with blue undertone (Midnight Terminal) -->
  <path android:pathData="M0,0h108v108h-108z"
        android:fillColor="#0F1419"/>

  <!-- Radial Glow: Blue gradient -->
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:centerX="54"
          android:centerY="54"
          android:gradientRadius="70"
          android:type="radial">
        <item android:offset="0.0" android:color="#8060A5FA"/>
        <item android:offset="0.4" android:color="#4D2563EB"/>
        <item android:offset="1.0" android:color="#FF0F1419"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Central Orb (Simulated Blur) -->
  <path android:pathData="M29,54a25,25 0 1,0 50,0a25,25 0 1,0 -50,0">
    <aapt:attr name="android:fillColor">
      <gradient
          android:centerX="54"
          android:centerY="54"
          android:gradientRadius="25"
          android:type="radial">
        <item android:offset="0.0" android:color="#16FFFFFF"/>
        <item android:offset="1.0" android:color="#00FFFFFF"/>
      </gradient>
    </aapt:attr>
  </path>
</vector>
